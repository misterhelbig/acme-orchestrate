
#!/bin/sh
# acme-orchestrate: desired-state ACME issuance and local staging, FreeBSD sh.
set -eu
umask 077

# Site-specific configuration.
if [ -r /usr/local/etc/acme/orchestrate.conf ]; then
    . /usr/local/etc/acme/orchestrate.conf
fi

# DNS zone used for delegated ACME DNS-01 challenges.
# Override using ACME_CHALLENGE_ZONE in the environment.
ACME_CHALLENGE_ZONE=${ACME_CHALLENGE_ZONE:-acme.example.net}

# Certificate management must run as the dedicated acme user.
if [ "$(id -un)" != acme ]; then
    printf 'acme-orchestrate: ERROR: must run as user acme\n' >&2
    exit 1
fi

# Select environment before processing internal worker arguments.
MODE=${ACME_ORCHESTRATE_MODE:-production}

case "${1:-}" in
  --staging)
    MODE=staging
    shift
    ;;
esac

case "$MODE" in
  production|staging) ;;
  *) printf 'Invalid ACME orchestration mode: %s\n' "$MODE" >&2; exit 2 ;;
esac

export ACME_ORCHESTRATE_MODE="$MODE"

# Select the configuration for the requested environment.
# An explicit override always takes precedence.
if [ -n "${ACME_DOMAINS_CONF:-}" ]; then
  CONFIG=$ACME_DOMAINS_CONF
elif [ "$MODE" = staging ] &&
     [ -e /usr/local/etc/acme/domains-staging.conf ]; then
  CONFIG=/usr/local/etc/acme/domains-staging.conf
else
  CONFIG=/usr/local/etc/acme/domains.conf
fi

PROD_BASE=${ACME_STATE_DIR:-/var/db/acme}

if [ "$MODE" = staging ]; then
  BASE=$PROD_BASE/test
  CA_SERVER=letsencrypt_test
  CA_URL=https://acme-staging-v02.api.letsencrypt.org/directory
else
  BASE=$PROD_BASE
  CA_SERVER=letsencrypt
  CA_URL=https://acme-v02.api.letsencrypt.org/directory
fi

CERTS=$BASE/certs
DEPLOY=$BASE/deployment
MANAGED=$BASE/managed-certificates
ACME=${ACME_BIN:-/usr/local/sbin/acme.sh}
ACME_HOME=$BASE/.acme.sh
DRY=0
say() { printf 'acme-orchestrate: %s\n' "$*" >&2; }
fail() { say "ERROR: $*"; exit 1; }

# Readiness-preserving, checksum-based comparisons; called under lock for writes.
replica_state() {
  rs_id=$1 rs_src=$2 rs_dst=$3
  [ -d "$rs_src" ] || return 1
  [ ! -L "$rs_dst" ] || return 1
  if [ ! -e "$rs_dst" ]; then printf 'create\n'; return 0; fi
  [ -d "$rs_dst" ] || return 1
  if [ ! -f "$rs_dst/$rs_id.ready" ] || [ -L "$rs_dst/$rs_id.ready" ]; then
    printf 'update\n'; return 0
  fi
  rs_diff=$(rsync -rclpni --delete --exclude="/$rs_id.ready" \
    "$rs_src/" "$rs_dst/") || return 1
  if [ -n "$rs_diff" ]; then printf 'update\n'; else printf 'unchanged\n'; fi
}

case ${1:-} in
  --publish)
    [ "$#" -eq 4 ] || exit 2
    id=$2; source=$3; target=$4
    case "$id" in ''|*[!A-Za-z0-9_-]*) exit 2 ;; esac
    [ "$target" = "$DEPLOY/$id" ] || exit 2
    [ -d "$source" ] || exit 2
    state=$(replica_state "$id" "$source" "$target") || exit 1
    if [ "$state" = unchanged ]; then say "$id unchanged (skipped)"; exit 0; fi
    mkdir -p "$target"
    rm -f "$target/$id.ready"
    rsync -rclpi --delete --exclude="/$id.ready" "$source/" "$target/" || exit 1
    : > "$target/$id.ready"
    say "$id $state"
    exit 0 ;;
  --remove)
    [ "$#" -eq 3 ] || exit 2
    id=$2; target=$3
    case "$id" in ''|*[!A-Za-z0-9_-]*) exit 2 ;; esac
    [ "$target" = "$DEPLOY/$id" ] || exit 2
    [ ! -L "$target" ] || exit 2
    rm -f "$target/$id.ready"
    rm -rf "$target"
    exit 0 ;;
esac

case ${1:-} in
  --dry-run) DRY=1 ;;
  --locked) ;; # Internal entry, started under the global lock.
  '')
    mkdir -p "$BASE"
    : >> "$BASE/orchestrate.lock"
    lockf -k "$BASE/orchestrate.lock" /bin/sh "$0" --locked
    exit $? ;;
  *) fail 'Usage: acme-orchestrate [--dry-run]' ;;
esac

if [ "$DRY" -eq 1 ]; then
  say "mode: $MODE (dry-run)"
else
  say "mode: $MODE"
fi

say "configuration: $CONFIG"
say "state directory: $BASE"

[ -r "$CONFIG" ] || fail "cannot read $CONFIG"

if [ "$MODE" = staging ]; then
  mkdir -p "$CERTS" "$ACME_HOME"
fi

[ -d "$CERTS" ] || fail "certificate directory missing: $CERTS"


for tool in awk openssl rsync lockf sort comm cmp; do
  command -v "$tool" >/dev/null 2>&1 || fail "missing command: $tool"
done

[ -x "$ACME" ] || fail "acme.sh not executable: $ACME"

WORK=$(mktemp -d "$BASE/.orchestrate.XXXXXXXX") || fail 'mktemp failed'
trap 'rm -rf "$WORK"' EXIT
trap 'exit 1' HUP INT TERM

mkdir "$WORK/tree"
: > "$WORK/errors"
: > "$WORK/records"
: > "$WORK/bundles"
: > "$WORK/aliases"
: > "$WORK/plans"
: > "$WORK/removals"

issue_error() { printf '%s\n' "$*" >> "$WORK/errors"; }

# Parse all valid rows; collect syntax problems instead of stopping at the first.
awk -v records="$WORK/records" -v bundles="$WORK/bundles" \
    -v aliases="$WORK/aliases" -v errors="$WORK/errors" '
function trim(s) {
  sub(/^[ \t]+/,"",s)
  sub(/[ \t]+$/, "", s)
  return s
}

function bad(s) {
  print "domains.conf:" NR ": " s >> errors
  invalid=1
}

function domainok(s, n,a,i) {
  if(length(s)>253 || s !~ /^[A-Za-z0-9.-]+$/ ||
     s ~ /\.\./ || s ~ /^\./ || s ~ /\.$/) return 0
  n=split(s,a,".")
  if(n<2) return 0
  for(i=1;i<=n;i++)
    if(length(a[i])<1 || length(a[i])>63 ||
       a[i] !~ /^[A-Za-z0-9]/ || a[i] !~ /[A-Za-z0-9]$/) return 0
  return 1
}

function relok(s, n,a,i) {
  if(s=="*") return 1
  if(s=="" || s ~ /\.$/ || s ~ /^\./ || s ~ /\.\./ ||
     s ~ /\*/ || s !~ /^[A-Za-z0-9.-]+$/) return 0
  n=split(s,a,".")
  for(i=1;i<=n;i++)
    if(length(a[i])<1 || length(a[i])>63 ||
       a[i] !~ /^[A-Za-z0-9]/ || a[i] !~ /[A-Za-z0-9]$/) return 0
  return 1
}

{
  line=$0
  sub(/\r$/, "", line)
  line=trim(line)
  if(line=="" || line ~ /^#/) next

  invalid=0

  if(line ~ /^\$/) {
    n=split(line,a,"=")
    if(n!=2) {
      bad("invalid replica alias definition")
      next
    }

    name=trim(a[1])
    target=trim(a[2])
    id=substr(name,2)

    if(name !~ /^\$[A-Za-z][A-Za-z0-9_-]*$/ ||
       id in aliasseen) {
      bad("invalid or duplicate replica alias")
      next
    }

    if(target !~ /^\/[A-Za-z0-9_.\/-]+\/$/ &&
       target !~ /^([A-Za-z_][A-Za-z0-9_-]*@)?[A-Za-z0-9][A-Za-z0-9_.-]*:\/[A-Za-z0-9_.\/-]+\/$/) {
        bad("invalid destination for " name)
        next
    }

    if(target ~ /\/\.\.\//) {
        bad("unsafe destination for " name)
        next
    }
    if(target in destinationseen) {
      bad("replica destination " target \
          " already assigned to $" destinationseen[target])
      next
    }

    destinationseen[target]=id

    aliasseen[id]=1
    destination[id]=target
    print id "|" target >> aliases
    next
  }

  n=split(line,a,":")
  if(n!=5) {
    bad("expected domain:challenge-alias:replicas:apex:SANs")
    next
  }

  for(i=1;i<=5;i++) a[i]=trim(a[i])

  domain=a[1]
  challenge=a[2]
  replicas=a[3]
  apex=a[4]
  sans=a[5]

  if(!domainok(domain))
    bad("invalid domain " domain)

  if(length(challenge)>63 ||
     challenge !~ /^[A-Za-z0-9][A-Za-z0-9-]*$/)
    bad("invalid challenge alias")

  if(apex!="apex" && apex!="none")
    bad("apex must be apex or none")

  # Every certificate must contain either a wildcard or
  # at least one explicit SAN.
  if(sans=="")
    bad("SAN list cannot be empty")

  has_wildcard=0
  has_explicit=0

  if(sans!="") {
    m=split(sans,s,",")
    sans=""

    for(i=1;i<=m;i++) {
      s[i]=trim(s[i])

      if(!relok(s[i]))
        bad("invalid relative SAN: " s[i])

      if(s[i] in row_sans)
        bad("duplicate relative SAN: " s[i])

      row_sans[s[i]]=1

      if(s[i]=="*")
        has_wildcard=1
      else
        has_explicit=1

      sans=sans (i==1 ? "" : ",") s[i]
    }

    # Wildcard certificates must include the apex and
    # cannot contain any explicit SANs.
    if(has_wildcard) {
      if(apex!="apex")
        bad("wildcard certificates must include the apex")

      if(has_explicit)
        bad("wildcard cannot be combined with explicit SANs")
    }

    for(i=1;i<=m;i++)
      delete row_sans[s[i]]
  }

  # Identity is stable as long as apex or the first explicit
  # SAN remains unchanged.
  first=substr(sans,1,index(sans,",") ? index(sans,",")-1 : length(sans))
  primary=(apex=="apex" ? domain : first "." domain)

  if(primary in seenprimary)
    bad("duplicate primary certificate identity " primary)

  if(challenge in seenchallenge)
    bad("challenge alias " challenge \
        " already assigned to " seenchallenge[challenge])

  if(replicas=="")
    bad("no replicas")

  k=split(replicas,r,",")

  for(i=1;i<=k;i++) {
    id=trim(r[i])
    alias=substr(id,2)

    if(id !~ /^\$[A-Za-z][A-Za-z0-9_-]*$/) {
      bad("invalid replica reference " id)
      continue
    }

    if(!(alias in destination)) {
      bad("undefined replica alias " id)
      continue
    }

    if((primary SUBSEP alias) in seenpair)
      bad("duplicate replica for " primary)
  }

  if(invalid) next

  seenprimary[primary]=1
  seenchallenge[challenge]=primary
  print primary "|" domain "|" challenge "|" apex "|" sans >> bundles

  for(i=1;i<=k;i++) {
    alias=substr(trim(r[i]),2)
    seenpair[primary,alias]=1
    print primary "|" domain "|" challenge "|" alias "|" apex "|" sans >> records
  }
}

END {
  if(length(seenprimary)==0)
    print "domains.conf: no valid domain definitions" >> errors
}
' "$CONFIG" || issue_error 'configuration parser failed'

# Inventory is an explicit ownership boundary: never delete unmanaged certs.
if [ -e "$MANAGED" ]; then
  [ -f "$MANAGED" ] && [ ! -L "$MANAGED" ] ||
    issue_error "invalid managed inventory: $MANAGED"

  if [ -f "$MANAGED" ]; then
    awk -F '|' '
      NF!=2 ||
      $1 !~ /^[A-Za-z0-9.-]+$/ ||
      $2 !~ /^[A-Za-z0-9.*-]+$/ ||
      $1 ~ /\.\./ ||
      $2 ~ /\.\./ {
        print "invalid managed inventory line " NR
        bad=1
      }
      END {exit bad}
    ' "$MANAGED" > "$WORK/inventory-errors" ||
      issue_error 'managed inventory contains invalid rows; removals disabled'

    cat "$WORK/inventory-errors" >> "$WORK/errors"
  fi
fi

# A certificate's actual X.509 DNS SAN list (not a hostname coverage test).
certificate_sans() {
  cs_cert=$1 cs_out=$2
  openssl x509 -in "$cs_cert" -noout -ext subjectAltName \
    > "$WORK/x509-san" 2>/dev/null || return 1

  awk '{
    n=split($0,a,",")
    for(i=1;i<=n;i++) {
      v=a[i]
      sub(/^[ \t]+/,"",v)
      sub(/[ \t]+$/,"",v)
      if(substr(v,1,4)=="DNS:")
        print substr(v,5)
    }
  }' "$WORK/x509-san" | LC_ALL=C sort -u > "$cs_out"

  [ -s "$cs_out" ]
}

wanted_sans() {
  ws_domain=$1
  ws_apex=$2
  ws_sans=$3
  ws_out=$4

  awk -v d="$ws_domain" -v apex="$ws_apex" -v sans="$ws_sans" '
    BEGIN {
      if(apex=="apex") print d
      n=split(sans,a,",")
      for(i=1;i<=n;i++)
        if(a[i]!="")
          print a[i] "." d
    }
  ' | LC_ALL=C sort -u > "$ws_out"
}

# True only when the actual certificate, key and acme.sh registration agree.
check_certificate() {
  cc_primary=$1
  cc_challenge=$2
  cc_wanted=$3

  cc_dir=$CERTS/${cc_primary}_ecc
  cc_cert=$cc_dir/fullchain.cer
  cc_key=$cc_dir/$cc_primary.key
  cc_conf=$cc_dir/$cc_primary.conf

  [ -s "$cc_cert" ] && [ -s "$cc_key" ] && [ -s "$cc_conf" ] ||
    return 1

  certificate_sans "$cc_cert" "$WORK/current-sans" || return 1
  cmp -s "$cc_wanted" "$WORK/current-sans" || return 1

  openssl x509 -in "$cc_cert" -noout -checkend 604800 \
    >/dev/null 2>&1 || return 1

  openssl x509 -in "$cc_cert" -noout -pubkey \
    > "$WORK/cert.pub" 2>/dev/null || return 1

  openssl pkey -in "$cc_key" -pubout \
    > "$WORK/key.pub" 2>/dev/null || return 1

  cmp -s "$WORK/cert.pub" "$WORK/key.pub" || return 1

  # Check the saved renewal configuration too, to avoid future SAN regression.
  cc_domain=$(awk -F "'" '$1=="Le_Domain="{print $2; exit}' "$cc_conf")
  cc_alt=$(awk -F "'" '$1=="Le_Alt="{print $2; exit}' "$cc_conf")
  cc_webroot=$(awk -F "'" '$1=="Le_Webroot="{print $2; exit}' "$cc_conf")
  cc_alias=$(awk -F "'" '$1=="Le_ChallengeAlias="{print $2; exit}' "$cc_conf")
  cc_api=$(awk -F "'" '$1=="Le_API="{print $2; exit}' "$cc_conf")

  [ "$cc_domain" = "$cc_primary" ] || return 1
  [ "$cc_webroot" = dns_nsupdate ] || return 1
  [ "${cc_alias%%,*}" = "$cc_challenge.$ACME_CHALLENGE_ZONE" ] || return 1
  [ "$cc_api" = "$CA_URL" ] || return 1

  awk -v domain="$cc_domain" -v alt="$cc_alt" '
    BEGIN {
      print domain
      n=split(alt,a,",")
      for(i=1;i<=n;i++)
        if(a[i]!="" && a[i]!="no")
          print a[i]
    }
  ' | LC_ALL=C sort -u > "$WORK/registered-sans"

  cmp -s "$cc_wanted" "$WORK/registered-sans"
}

# Look up and check the exact CNAME, without exposing broader-zone credentials.
dns_alias() {
  da_name=$1

  if command -v dig >/dev/null 2>&1; then
    da_output=$(dig +time=2 +tries=1 +noall +comments +answer \
      "$da_name" CNAME 2>&1) || return 1

    case "$da_output" in
      *"status: NOERROR"*|*"status: NXDOMAIN"*) ;;
      *) return 1 ;;
    esac

  elif command -v drill >/dev/null 2>&1; then
    da_output=$(drill -t CNAME "$da_name" 2>&1) || return 1

    case "$da_output" in
      *"rcode: NOERROR"*|*"rcode: NXDOMAIN"*) ;;
      *) return 1 ;;
    esac

  else
    return 2
  fi

  # A successful DNS response may legitimately contain no CNAME.
  # In that case, return success with empty output.
  printf '%s\n' "$da_output" |
    awk '$4=="CNAME" {print $5; exit}'
}

check_dns() {
  dn_domain=$1
  dn_challenge=$2
  dn_wanted=$3
  dn_expect="_acme-challenge.$dn_challenge.$ACME_CHALLENGE_ZONE."

  while IFS= read -r dn_name; do
    case "$dn_name" in
      \*.*) dn_query=${dn_name#\*.} ;;
      *) dn_query=$dn_name ;;
    esac

    dn_record="_acme-challenge.$dn_query."
    dn_attempt=1
    dn_success=no

    while [ "$dn_attempt" -le 3 ]; do
      if dn_actual=$(dns_alias "_acme-challenge.$dn_query"); then
        dn_success=yes
        break
      else
        dn_rc=$?
      fi

      if [ "$dn_rc" -eq 2 ]; then
        issue_error "DNS lookup unavailable for $dn_name (dig/drill required)"
        break
      fi

      if [ "$dn_attempt" -lt 3 ]; then
        say "DNS lookup failed for $dn_name (attempt $dn_attempt/3); retrying"
        sleep 1
      fi

      dn_attempt=$((dn_attempt + 1))
    done

    if [ "$dn_success" != yes ]; then
      if [ "$dn_rc" -ne 2 ]; then
        issue_error "DNS lookup failed for $dn_name after 3 attempts
        Query: $dn_record IN CNAME"
      fi
      continue
    fi

    dn_actual=$(printf '%s' "$dn_actual" |
      tr '[:upper:]' '[:lower:]')

    if [ "$dn_actual" != "$dn_expect" ]; then
      issue_error "DNS delegation mismatch for $dn_name
        Expected: $dn_record IN CNAME $dn_expect
        Found:    $dn_record IN CNAME ${dn_actual:-MISSING}"
    fi

  done < "$dn_wanted"
}

# Plan all certificate actions without modifying acme.sh.
while IFS='|' read -r primary domain challenge apex sans; do
  wanted_sans "$domain" "$apex" "$sans" "$WORK/wanted"

  if [ ! -d "$CERTS/${primary}_ecc" ]; then
    action=issue
  elif check_certificate "$primary" "$challenge" "$WORK/wanted"; then
    action=unchanged
  else
    action=reissue
  fi

  printf '%s|%s|%s|%s|%s|%s\n' \
    "$primary" "$domain" "$action" "$challenge" "$apex" "$sans" \
    >> "$WORK/plans"

  check_dns "$domain" "$challenge" "$WORK/wanted"

done < "$WORK/bundles"

# Find managed identities no longer in the desired state, including primary changes.
if [ -f "$MANAGED" ] && [ ! -s "$WORK/errors" ]; then
  while IFS='|' read -r olddomain oldprimary; do
    [ -n "$olddomain" ] || continue

    if ! awk -F '|' -v d="$olddomain" -v p="$oldprimary" \
         '$2==d && $1==p {found=1} END {exit !found}' \
         "$WORK/plans"; then

      if awk -F '|' -v p="$oldprimary" \
           '$1==p {found=1} END {exit !found}' "$WORK/plans"; then
        issue_error "retiring $olddomain would delete primary $oldprimary still required by another domain"
      else
        printf '%s|%s\n' "$olddomain" "$oldprimary" >> "$WORK/removals"
      fi
    fi
  done < "$MANAGED"
fi

# Show full reconciliation report, including every detected problem.
report_plan() {
  say 'certificate reconciliation:'

  while IFS='|' read -r primary domain action challenge apex sans; do
    printf '  %-28s %-9s (domain: %s)\n' \
      "$primary" "$action" "$domain" >&2

    wanted_sans "$domain" "$apex" "$sans" "$WORK/wanted"

    oldcert=$CERTS/${primary}_ecc/fullchain.cer

    if [ -s "$oldcert" ] &&
       certificate_sans "$oldcert" "$WORK/oldnames"; then
      comm -13 "$WORK/oldnames" "$WORK/wanted" > "$WORK/added"
      comm -23 "$WORK/oldnames" "$WORK/wanted" > "$WORK/removed"
    else
      cp "$WORK/wanted" "$WORK/added"
      : > "$WORK/removed"
    fi

    if [ -s "$WORK/added" ] || [ -s "$WORK/removed" ]; then
      while IFS= read -r name; do
        printf '      + %s\n' "$name" >&2
      done < "$WORK/added"

      while IFS= read -r name; do
        printf '      - %s\n' "$name" >&2
      done < "$WORK/removed"
    fi
  done < "$WORK/plans"

  while IFS='|' read -r domain primary; do
    printf '  %-28s remove    (domain: %s)\n' \
      "$primary" "$domain" >&2
  done < "$WORK/removals"

  while IFS='|' read -r primary domain action challenge apex sans; do
    current="$CERTS/${primary}_ecc/fullchain.cer"

    if [ ! -s "$current" ]; then
      san_display='not issued locally'
    elif certificate_sans "$current" "$WORK/sans-display"; then
      san_display=$(awk '{
        printf "%sDNS:%s", (NR>1 ? ", " : ""), $0
      }' "$WORK/sans-display")
    else
      san_display='unreadable certificate'
    fi

    printf '  %-32s %s\n' \
      "$primary/fullchain.pem" "$san_display" >&2
  done < "$WORK/plans"

  if [ -s "$WORK/errors" ]; then
    say 'problems:'
    awk '
      /^    / { print; next }
      { print "  ERROR: " $0 }
    ' "$WORK/errors" >&2
  fi

}

report_deployed_sans() {
  mode=$1
  say "SAN changes versus published certificates ($mode):"
  any=0

  # Compare each desired certificate with its previously published
  # copy in each replica. A certificate may belong to multiple replicas.
  while IFS='|' read -r primary domain challenge id apex sans; do

    if [ "$mode" = desired ]; then
      wanted_sans "$domain" "$apex" "$sans" "$WORK/newnames"
    elif ! certificate_sans \
         "$CERTS/${primary}_ecc/fullchain.cer" "$WORK/newnames"; then
      say "  $primary: issued certificate unreadable; cannot compare"
      continue
    fi

    oldcert="$DEPLOY/$id/$primary/fullchain.pem"
    description=

    if [ -s "$oldcert" ] &&
       certificate_sans "$oldcert" "$WORK/oldnames"; then

      LC_ALL=C comm -13 "$WORK/oldnames" "$WORK/newnames" \
        > "$WORK/san-add"
      LC_ALL=C comm -23 "$WORK/oldnames" "$WORK/newnames" \
        > "$WORK/san-drop"

      description="changed in $id"

    else
      cp "$WORK/newnames" "$WORK/san-add"
      : > "$WORK/san-drop"

      if [ -e "$oldcert" ] || [ -L "$oldcert" ]; then
        description="unreadable in $id"
      else
        description="new to $id"
      fi
    fi

    if [ -s "$WORK/san-add" ] || [ -s "$WORK/san-drop" ]; then
      any=1

      printf '  %s/fullchain.pem (%s)\n' \
        "$primary" "$description" >&2

      while IFS= read -r name; do
        printf '    + %s\n' "$name" >&2
      done < "$WORK/san-add"

      while IFS= read -r name; do
        printf '    - %s\n' "$name" >&2
      done < "$WORK/san-drop"
    fi

  done < "$WORK/records"

  [ "$any" -ne 0 ] || say '  none'
}
report_plan

if [ "$DRY" -eq 1 ]; then
  # Build a content-comparison tree from existing, valid certificates only.
  while IFS='|' read -r primary domain challenge id apex sans; do
    mkdir -p "$WORK/tree/$id/$primary"

    if [ -s "$CERTS/${primary}_ecc/fullchain.cer" ] &&
       [ -s "$CERTS/${primary}_ecc/$primary.key" ]; then
      cp "$CERTS/${primary}_ecc/fullchain.cer" \
        "$WORK/tree/$id/$primary/fullchain.pem"
      cp "$CERTS/${primary}_ecc/$primary.key" \
        "$WORK/tree/$id/$primary/privkey.pem"
      chmod 644 "$WORK/tree/$id/$primary/fullchain.pem"
      chmod 600 "$WORK/tree/$id/$primary/privkey.pem"
    fi
  done < "$WORK/records"

  report_deployed_sans desired

  say 'proposed replica trees:'
  find "$WORK/tree" -mindepth 1 -print |
    sed "s|$WORK/tree/|  |" >&2

  say 'proposed deployment changes:'

  for path in "$WORK/tree"/*; do
    [ -d "$path" ] || continue
    id=${path##*/}

    state=$(replica_state "$id" "$path" "$DEPLOY/$id") || {
      state=error
      issue_error "cannot compare existing replica $id"
    }

    pending=$(awk -F '|' -v r="$id" '
      NR==FNR {
        if($3!="unchanged") pending[$1]=1
        next
      }
      $4==r && pending[$1] {found=1}
      END {print found?"yes":"no"}
    ' "$WORK/plans" "$WORK/records")

    if [ "$pending" = yes ]; then
      case "$state" in
        unchanged) state='update (pending certificate issuance)' ;;
        create) state='create (pending certificate issuance)' ;;
        *) state="$state (pending certificate issuance)" ;;
      esac
    fi

    printf '  %-8s %s\n' "$id" "$state" >&2
  done

  if [ -d "$DEPLOY" ] && [ ! -s "$WORK/errors" ]; then
    for path in "$DEPLOY"/*; do
      [ -d "$path" ] || continue
      id=${path##*/}
      [ -d "$WORK/tree/$id" ] ||
        printf '  %-8s remove\n' "$id" >&2
    done
  fi

  say 'proposed certificate housekeeping:'
  housekeeping=0

  for path in "$CERTS"/*; do
    [ -e "$path" ] || [ -L "$path" ] || continue

    name=${path##*/}

    if [ -L "$path" ]; then
      printf '  WARNING: symlink requires inspection: %s\n' \
        "$name" >&2
      continue
    fi

    if [ ! -d "$path" ]; then
      printf '  WARNING: unexpected file: %s\n' \
        "$name" >&2
      continue
    fi

    keep=no
    while IFS='|' read -r primary domain challenge apex sans; do
      if [ "$name" = "${primary}_ecc" ]; then
        keep=yes
        break
      fi
    done < "$WORK/bundles"

    [ "$keep" = no ] || continue

    case "$name" in
      ''|.|..|*[!A-Za-z0-9_.-]*)
        printf '  ERROR: unsafe certificate directory name: %s\n' \
          "$name" >&2
        issue_error "unsafe certificate directory name: $name"
        continue
        ;;
    esac

    printf '  remove %s/\n' "$name" >&2
    housekeeping=1
  done

  [ "$housekeeping" -ne 0 ] || say '  none'

  say 'no certificates or deployment directories modified'
  [ ! -s "$WORK/errors" ]
  exit $?
fi

# Any configuration or DNS error blocks all live mutations.
[ ! -s "$WORK/errors" ] ||
  fail 'no changes made; fix reported problems first'

# Apply issuance/reissuance.
while IFS='|' read -r primary domain challenge apex sans; do
  action=$(awk -F '|' -v p="$primary" \
    '$1==p {print $3; exit}' "$WORK/plans")

  if [ "$action" != unchanged ]; then
    wanted_sans "$domain" "$apex" "$sans" "$WORK/wanted"

    set -- --issue --dns dns_nsupdate \
      --challenge-alias "$challenge.$ACME_CHALLENGE_ZONE" \
      --domain "$primary" --keylength ec-256 --server "$CA_SERVER"

    while IFS= read -r certname; do
      [ "$certname" = "$primary" ] && continue
      set -- "$@" --domain "$certname"
    done < "$WORK/wanted"

    say "$domain: $action ($primary)"

    if [ "$action" = reissue ]; then
      set -- "$@" --force
    fi

    "$ACME" "$@" --home "$ACME_HOME" --cert-home "$CERTS" ||
      fail "acme.sh $action failed for $domain; published snapshots retained"
  else
    # acme.sh --renew returns 2 when the certificate is not due yet.
    say "$primary: checking scheduled renewal"
    renew_rc=0

    "$ACME" --renew -d "$primary" --ecc \
      --server "$CA_SERVER" \
      --home "$ACME_HOME" --cert-home "$CERTS" || renew_rc=$?

    case "$renew_rc" in
      0|2) ;;
      *) fail "acme.sh renewal failed for $domain (exit $renew_rc); published snapshots retained" ;;
    esac
  fi
done < "$WORK/bundles"

# Validate every resulting certificate before staging or changing any replica.
while IFS='|' read -r primary domain challenge apex sans; do
  wanted_sans "$domain" "$apex" "$sans" "$WORK/wanted"

  check_certificate "$primary" "$challenge" "$WORK/wanted" ||
    fail "certificate validation failed after issuance/renewal for $domain; deployment unchanged"
done < "$WORK/bundles"

# Build desired replica trees.
while IFS='|' read -r primary domain challenge id apex sans; do
  mkdir -p "$WORK/tree/$id/$primary"

  cp "$CERTS/${primary}_ecc/fullchain.cer" \
    "$WORK/tree/$id/$primary/fullchain.pem"

  cp "$CERTS/${primary}_ecc/$primary.key" \
    "$WORK/tree/$id/$primary/privkey.pem"

  chmod 644 "$WORK/tree/$id/$primary/fullchain.pem"
  chmod 600 "$WORK/tree/$id/$primary/privkey.pem"
done < "$WORK/records"

report_deployed_sans issued

mkdir -p "$DEPLOY"

for path in "$WORK/tree"/*; do
  [ -d "$path" ] || continue
  id=${path##*/}
  lock=$DEPLOY/$id.lock
  : >> "$lock"

  lockf -k "$lock" /bin/sh "$0" --publish \
    "$id" "$path" "$DEPLOY/$id" ||
    fail "publication failed for $id; managed inventory unchanged"
done

# Remove obsolete replica directories only after all desired ones are ready.
for path in "$DEPLOY"/*; do
  [ -d "$path" ] || continue
  id=${path##*/}
  [ -d "$WORK/tree/$id" ] && continue

  case "$id" in
    ''|*[!A-Za-z0-9_-]*) fail "unsafe replica directory: $id" ;;
  esac

  lock=$DEPLOY/$id.lock
  : >> "$lock"

  lockf -k "$lock" /bin/sh "$0" --remove "$id" "$path" ||
    fail "failed removing obsolete replica $id"

  say "removed obsolete replica $id (lock file retained)"
done

# The inventory records only identities this orchestrator has adopted.
# Removed identities are unregistered, then their local acme.sh files deleted.
# Removing a certificate does NOT revoke it at the CA.
while IFS='|' read -r olddomain oldprimary; do
  olddir=$CERTS/${oldprimary}_ecc

  if [ -d "$olddir" ]; then
    if [ -f "$olddir/$oldprimary.conf" ]; then
      say "unregistering obsolete certificate $olddomain ($oldprimary)"

      "$ACME" --remove --domain "$oldprimary" --ecc \
        --home "$ACME_HOME" --cert-home "$CERTS" ||
        fail "cannot unregister obsolete certificate $oldprimary"
    fi

    [ ! -L "$olddir" ] ||
      fail "refusing symlink certificate directory $olddir"

    rm -rf "$olddir" ||
      fail "cannot remove obsolete certificate directory $olddir"

    say "removed obsolete certificate files: $oldprimary"
  fi
done < "$WORK/removals"

# Housekeeping: remove unexpected directories from the certificate store.
# The desired bundle list defines which certificate directories belong here.
# This runs only after successful certificate validation and publication.
for path in "$CERTS"/*; do
  [ -e "$path" ] || [ -L "$path" ] || continue

  name=${path##*/}

  # Do not follow or delete symbolic links.
  [ ! -L "$path" ] ||
    fail "unexpected symlink in certificate store: $path"

  # Only immediate directories are eligible for automatic cleanup.
  if [ ! -d "$path" ]; then
    say "WARNING: unexpected non-directory in certificate store: $path"
    continue
  fi

  # Keep every directory belonging to a desired certificate.
  keep=no
  while IFS='|' read -r primary domain challenge apex sans; do
    if [ "$name" = "${primary}_ecc" ]; then
      keep=yes
      break
    fi
  done < "$WORK/bundles"

  [ "$keep" = no ] || continue

  case "$name" in
    ''|.|..|*[!A-Za-z0-9_.-]*)
      fail "unsafe certificate directory name: $name"
      ;;
  esac

  rm -rf "$path" ||
    fail "cannot remove orphaned certificate directory: $path"

  say "removed orphaned certificate directory: $name"
done

# Atomic replacement of the managed-identity inventory.
awk -F '|' '{print $2 "|" $1}' "$WORK/plans" > "$WORK/managed-new"

chmod 600 "$WORK/managed-new"

cp "$WORK/managed-new" "$BASE/.managed-certificates.new.$$"
mv -f "$BASE/.managed-certificates.new.$$" "$MANAGED"

say 'certificate reconciliation and deployment staging complete'

